{
  "version": 3,
  "configurePresets": [
    {
      "name": "minimal-sdrplay",
      "hidden": true,
      "cacheVariables": {
        "SDRPP_MODULE_DEFAULTS": "MINIMAL",
        "OPT_BACKEND_GLFW": "ON",
        "OPT_BACKEND_ANDROID": "OFF",
        "OPT_BUILD_FILE_SOURCE": "ON",
        "OPT_BUILD_AUDIO_SOURCE": "ON",
        "OPT_BUILD_SDRPLAY_SOURCE": "ON",
        "OPT_BUILD_AUDIO_SINK": "ON",
        "OPT_BUILD_NEW_PORTAUDIO_SINK": "ON",
        "OPT_BUILD_ATV_DECODER": "ON",
        "OPT_BUILD_CH_EXTRAVHF_DECODER": "ON",
        "OPT_BUILD_CH_TETRA_DEMODULATOR": "ON",
        "OPT_BUILD_METEOR_DEMODULATOR": "ON",
        "OPT_BUILD_PAGER_DECODER": "ON",
        "OPT_BUILD_RADIO": "ON",
        "OPT_BUILD_FT8_DECODER": "ON",
        "OPT_BUILD_ADSB_DECODER": "ON",
        "OPT_BUILD_MESHTASTIC_DECODER": "ON",
        "OPT_BUILD_MESHCORE_DECODER": "ON",
        "OPT_BUILD_RYFI_DECODER": "ON",
        "OPT_BUILD_VOR_RECEIVER": "ON",
        "OPT_BUILD_FREQUENCY_MANAGER": "ON",
        "OPT_BUILD_IQ_EXPORTER": "ON",
        "OPT_BUILD_RECORDER": "ON",
        "OPT_BUILD_SCANNER": "ON",
        "OPT_BUILD_NOISE_REDUCTION_LOGMMSE": "ON",
        "USE_INTERNAL_LIBCORRECT": "ON",
        "USE_BUNDLE_DEFAULTS": "OFF",
        "COPY_MSVC_REDISTRIBUTABLES": "OFF",
        "SDRPP_USE_BUNDLED_VOLK": "ON"
      }
    },
    {
      "name": "windows-vs2022",
      "inherits": "minimal-sdrplay",
      "displayName": "Windows x64 + vcpkg",
      "description": "Runnable SDRplay development build using VS2022 and vcpkg",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_APPLOCAL_DEPS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "configurePreset": "windows-vs2022",
      "configuration": "RelWithDebInfo",
      "jobs": 0
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "jobs": 0
    }
  ]
}
