				"OPT_BUILD_KIWISDR_SOURCE": "OFF",
				"OPT_BUILD_ANDROID_AUDIO_SINK": "OFF",
				"OPT_BUILD_AUDIO_SINK": "ON",
				"OPT_BUILD_NETWORK_SINK": "OFF",
				"OPT_BUILD_MPEG_ADTS_SINK": "OFF",
				"OPT_BUILD_NEW_PORTAUDIO_SINK": "ON",
				"OPT_BUILD_PORTAUDIO_SINK": "OFF",
