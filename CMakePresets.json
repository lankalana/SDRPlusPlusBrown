		},
		{
			"name": "windows-vs2022",
			"inherits": [
				"sdrplay-base"
			],
			"displayName": "Windows x64 - VS 2022 + vcpkg",
			"description": "Development build using VS2022, vcpkg and PothosSDR",
			"generator": "Visual Studio 17 2022",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-windows",
				"PYTHON_EXECUTABLE": "${sourceDir}/.venv/Scripts/python.exe"
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-relwithdebinfo",
			"displayName": "Windows RelWithDebInfo",
			"configurePreset": "windows-vs2022",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "windows-release",
			"displayName": "Windows Release",
			"configurePreset": "windows-vs2022",
			"configuration": "Release"
		}
	]
